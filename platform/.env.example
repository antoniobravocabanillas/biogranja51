# Fallback local sin Supabase. No habilitar estos valores en producción.
ADMIN_READ_ENABLED=false
ADMIN_WRITE_ENABLED=false
ORDER_WRITE_ENABLED=false

# Supabase productivo. Usa la clave publicable actual; la anon legacy queda
# como compatibilidad temporal si tu proyecto aún no creó publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
